# sbnd detector in det frame +10cm around detector

sbnd_detector_box:
[-210, 210, -210, 210, -10, 510]

sbnd_bnb_solid_angle_box:
1.3223e-3

physics.producers.generator.RayTrace.Volume:
  @erase

physics.producers.generator.RayTrace.Box:
  @local::sbnd_detector_box

physics.producers.generator.RayTrace.ReferenceSolidAngle:
  @local::sbnd_bnb_solid_angle_box
