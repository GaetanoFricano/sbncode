#include "prodoverlay_corsika_MeVPrtl_LLP_scalar_sbnd.fcl"

###----------Set scalar mass----------###

scalarM: 0.250

physics.producers.generator.Flux.M:
  @local::scalarM

physics.producers.generator.RayTrace.ReferencePrtlMass:
  @local::scalarM

physics.producers.generator.Decay.ReferenceMass:
  @local::scalarM


###----------Production BR----------###

BRprod: 1e-11

physics.producers.generator.Flux.BRprod:
  @local::BRprod


###----------Lifetime----------###

CTau_cm: 5000

physics.producers.generator.Decay.CTau_cm:
  @local::CTau_cm

physics.producers.generator.Decay.ReferenceCTau_cm:
  @local::CTau_cm


###----------Decay BR----------###

BR_ee: 1.0

physics.producers.generator.Decay.BR_ee:
  @local::BR_ee


###-----------Verbose--------------###

#include "set_MeVPrtl_Verbose.fcl"

###----------Set geometry ----------###

#include "set_MeVPrtl_GeoTPC.fcl"
